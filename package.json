{
  "name": "@tahir810/react-native-upi",
  "version": "1.0.1",
  "description": "Clean, lightweight, and complete React Native module for UPI payments using native Android Intent (startActivityForResult). Supports Google Pay, PhonePe, Paytm, BHIM, Cred, and System Chooser.",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "react-native.config.js",
    "!android/build",
    "!android/.gradle",
    "!android/bin",
    "!android/.project",
    "!android/.classpath",
    "!android/.settings",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "upi",
    "google-pay",
    "phonepe",
    "paytm",
    "bhim",
    "gpay",
    "payment",
    "android",
    "intent",
    "startActivityForResult"
  ],
  "author": "Tahir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahir81018/react-native-upi.git"
  },
  "homepage": "https://github.com/tahir81018/react-native-upi#readme",
  "bugs": {
    "url": "https://github.com/tahir81018/react-native-upi/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
